rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email == 'harshusm3107@gmail.com' || request.auth.token.email_verified == true);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Rules ---
    match /students/{studentId} {
      allow get, list: if isSignedIn();
      
      allow create: if isVerified() 
        && incoming().name is string
        && incoming().studentId is string;
        
      allow update: if isVerified()
        && incoming().name is string;

      allow delete: if isVerified();
    }

    match /activities/{activityId} {
      allow get, list: if isSignedIn();
      
      allow create: if isVerified()
        && incoming().studentId is string;

      allow update: if isVerified();

      allow delete: if isVerified();
    }
  }
}
